  "components": {
    "schemas": {
      "BehaviorEventRequest": {
        "properties": {
          "anonymous_id": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Anonymous Id"
          },
          "session_code": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Session Code"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "page_view",
              "product_view",
              "product_view_duration",
              "product_impression",
              "product_click",
              "add_to_cart",
              "cart_view",
              "checkout_start",
              "checkout_abandon",
              "order_submit",
              "purchase_success"
            ],
            "title": "Event Type"
          },
          "page_path": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Page Path"
          },
          "product_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Code"
          },
          "sku_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku Code"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "referrer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Referrer"
          },
          "utm_source": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Utm Source"
          },
          "utm_medium": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Utm Medium"
          },
          "utm_campaign": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Utm Campaign"
          }
        },
        "type": "object",
        "required": [
          "anonymous_id",
          "session_code",
          "event_type",
          "page_path"
        ],
        "title": "BehaviorEventRequest"
      },
      "BehaviorEventResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
            "default": true
          },
          "event_code": {
            "type": "string",
            "title": "Event Code"
          },
          "session_code": {
            "type": "string",
            "title": "Session Code"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "type": "object",
        "required": [
          "event_code",
          "session_code",
          "event_type",
          "occurred_at"
        ],
        "title": "BehaviorEventResponse"
      },
      "CartIdentityRequest": {
        "properties": {
          "anonymous_id": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Anonymous Id"
          },
          "session_code": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Session Code"
          }
        },
        "type": "object",
        "required": [
          "anonymous_id",
          "session_code"
        ],
        "title": "CartIdentityRequest"
      },
      "CartItemUpsertRequest": {
        "properties": {
          "anonymous_id": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Anonymous Id"
          },
          "session_code": {
            "type": "string",
            "maxLength": 96,
            "minLength": 8,
            "title": "Session Code"
          },
          "product_id": {
            "type": "string",
            "maxLength": 96,
            "minLength": 1,
            "title": "Product Id"
          },
          "sku": {
            "type": "string",
            "maxLength": 96,
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "maximum": 999.0,
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "anonymous_id",
          "session_code",
          "product_id",
          "sku",
          "quantity"
        ],
        "title": "CartItemUpsertRequest"
      },
      "CartLineResponse": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_price_cents": {
            "type": "integer",
            "title": "Unit Price Cents"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "line_subtotal_cents": {
            "type": "integer",
            "title": "Line Subtotal Cents"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "sku",
          "name",
          "quantity",
          "unit_price_cents",
          "currency",
          "line_subtotal_cents"
        ],
        "title": "CartLineResponse"
      },
      "CartResponse": {
        "properties": {
          "cart_code": {
            "type": "string",
            "title": "Cart Code"
          },
          "anonymous_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anonymous Id"
          },
          "session_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Code"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "line_count": {
            "type": "integer",
            "title": "Line Count"
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count"
          },
          "subtotal_cents": {
            "type": "integer",
            "title": "Subtotal Cents"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/CartLineResponse"
            },
            "type": "array",
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "cart_code",
          "anonymous_id",
          "session_code",
          "currency",
          "line_count",
          "item_count",
          "subtotal_cents",
          "lines"
        ],
        "title": "CartResponse"
      },
      "CatalogCategoriesResponse": {
        "properties": {
          "data_source": {
            "type": "string",
            "const": "d2c_database_catalog",
            "title": "Data Source",
            "default": "d2c_database_catalog"
          },
          "count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Count"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CatalogCategory"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "count",
          "categories"
        ],
        "title": "CatalogCategoriesResponse"
      },
      "CatalogCategory": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Storefront category code."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Storefront category name."
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order",
            "description": "Display sort order."
          }
        },
        "type": "object",
